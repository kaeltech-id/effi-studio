<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.efficlaude.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>EFFICLAUDE_HOME/server/worker.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>EFFICLAUDE_HOME/worker.log</string>
  <key>StandardErrorPath</key>
  <string>EFFICLAUDE_HOME/worker.log</string>
  <key>WorkingDirectory</key>
  <string>EFFICLAUDE_HOME</string>
</dict>
</plist>
